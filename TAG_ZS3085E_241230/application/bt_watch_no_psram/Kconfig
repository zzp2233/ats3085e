mainmenu "BT Watch App"

# 先载入通用配置，包括 Shell 和文件系统等子系统的选项。
source "Kconfig.zephyr"

menu "App Configuration"

# 应用线程优先级的默认值为 10；配置可由应用或板级输入覆盖。
config APP_PRIORITY
    int
    prompt "App Thread Priority"
    default 10
    help
    This option set app thread priority

# 应用线程栈容量，单位为字节。这里默认 2048，应用的 prj.conf 请求 1536。
config APP_STACKSIZE
    int
    prompt "App Thread Stack Size"
    default 2048
    help
    This option set stack size for app thread

# 第二个 UI 资源卷名，默认 /SD:B。
config APP_UI_DISK_B
	string "drive name for ui resource"
	default "/SD:B"
	help
	  This option set driver name for ui resource

# UI 主资源卷名，默认 /SD:A。
config APP_UI_DISK
	string "drive name for ui resource"
	default "/SD:A"
	help
	  This option set driver name for ui resource

# 字体资源卷名，默认 /SD:C。
config APP_FONT_DISK
	string "drive name for ui resource"
	default "/SD:C"
	help
	  This option set driver name for ui resource

# 应用访问 FatFs 时使用的卷名。
config APP_FAT_DISK
	string "drive name for fatfs"
	default "/SD:"
	help
	  This option set drive name for fatfs

# 欢迎界面所用的资源卷，与主界面分开配置。
config WELCOME_UI_DISK
	string "drive name for welcome ui resource"
	default "/SD:A"
	help
	  This option set driver name for welcome ui resource

# 从本 Kconfig 所在目录载入业务选项，BT_MAIN_APP 的定义在这里引用的文件中。
rsource "src/Kconfig"

endmenu



