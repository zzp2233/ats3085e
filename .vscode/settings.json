{
  // ATS3085E 调试串口：UART0 / 115200 / 8-N-1 / 无流控
  // 板端配置来源：zephyr/.config 里 CONFIG_UART_ACTS_PORT_0_BAUD_RATE=115200
  // 引脚：TX=GPIO28、RX=GPIO29（zephyr/boards/arm/ats3085e_dev_watch_ext_nor/board.c）

  // 让波特率下拉框里出现 2000000 等非标准档位（内置列表只有常见几档）
  "vscode-serial-monitor.customBaudRates": [
    2000000,
    921600,
    460800,
    230400,
    115200
  ],

  "vscode-serial-monitor.dataBits": 8,
  "vscode-serial-monitor.stopBits": 1,
  "vscode-serial-monitor.parity": "none",
  "vscode-serial-monitor.lineEnding": "\n",

  // 板端固件关闭了 printk 自带时间戳，这里由 VSCode 补上，方便定位时序
  "vscode-serial-monitor.timestampFormat": "HH:mm:ss.SSS",
  "vscode-serial-monitor.timestampSeparator": " | ",

  // 串口内容可一键保存到该目录，方便事后复盘
  "vscode-serial-monitor.logFileDirectory": "D:\\ats3085e\\logs",
  "vscode-serial-monitor.outputFontSize": 13
}
